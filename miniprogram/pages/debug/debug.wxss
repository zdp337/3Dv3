.debug-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 48rpx;
  background: #f7f9ff;
  color: #22293a;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
}

.desc {
  color: #6a7387;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.btn {
  width: 320rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #5e75ff;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}
